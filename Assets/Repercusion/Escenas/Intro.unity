  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 49dcf124a42f9cf4b9d99fabd4f48b5e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Repercusion.IntroSecuencia
  diapositivas:
  - texto: "Eco pas\xF3 a\xF1os construyendo una sola m\xE1quina:\nuna puerta para
      volver atr\xE1s en el tiempo."
    imagen: {fileID: 0}
    espera: 2.5
    glitch: 0
  - texto: "Quer\xEDa corregir un error.\nSolo uno."
    imagen: {fileID: 0}
    espera: 2.5
    glitch: 0
  - texto: "No esper\xF3 a que estuviera lista."
    imagen: {fileID: 0}
    espera: 2.5
    glitch: 0
  - texto: "Y el tiempo se rompi\xF3."
    imagen: {fileID: 0}
    espera: 1.5
    glitch: 1
  - texto: "Ahora, cada vez que lo intenta de nuevo,\nlo que hizo antes se queda
      atr\xE1s\u2026 repiti\xE9ndose."
    imagen: {fileID: 0}
    espera: 2.5
    glitch: 0
  - texto: Ecos de lo que pudo haber sido.
    imagen: {fileID: 0}
    espera: 3
    glitch: 0
  grupo: {fileID: 205857686}
  texto: {fileID: 996186257}
  imagen: {fileID: 863093777}
  flash: {fileID: 596609422}
  glitch: {fileID: 14063773}
  letrasPorSegundo: 38
  fundido: 0.6
  escenaSiguiente: 

  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 49dcf124a42f9cf4b9d99fabd4f48b5e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Repercusion.IntroSecuencia
  diapositivas:
  - texto: "Eco era una cient\xEDfica brillante\u2026\ny ambiciosa."
    imagen: {fileID: 0}
    espera: 2.5
    glitch: 0
  - texto: "Quer\xEDa crear lo que nadie hab\xEDa logrado:\nuna m\xE1quina para atravesar
      el tiempo."
    imagen: {fileID: 0}
    espera: 2.5
    glitch: 0
  - texto: Estuvo a punto de conseguirlo.
    imagen: {fileID: 0}
    espera: 2.5
    glitch: 0
  - texto: "Y entonces, fall\xF3."
    imagen: {fileID: 0}
    espera: 1.5
    glitch: 1
  - texto: "Despert\xF3 en un calabozo\nque no existe en ning\xFAn tiempo."
    imagen: {fileID: 0}
    espera: 2.5
    glitch: 0
  - texto: "La \xFAnica salida est\xE1 sellada con tres llaves."
    imagen: {fileID: 0}
    espera: 2.5
    glitch: 0
  - texto: "Aqu\xED la fuerza no sirve.\nSolo su ingenio\u2026"
    imagen: {fileID: 0}
    espera: 2.5
    glitch: 0
  - texto: "\u2026y los ecos de lo que pudo haber sido."
    imagen: {fileID: 0}
    espera: 3
    glitch: 0
  grupo: {fileID: 1893201916}
  texto: {fileID: 1923053665}
  imagen: {fileID: 1099901881}
  flash: {fileID: 376785815}
  glitch: {fileID: 346378366}
  letrasPorSegundo: 38
  fundido: 0.6
  escenaSiguiente: 
